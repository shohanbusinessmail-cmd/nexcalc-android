    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_owner">Owner</string>
    <string name="about_contact">Contact</string>
    <string name="about_offline">Fully offline</string>
    <string name="about_offline_body">NEXCALC has no INTERNET permission, no accounts, no advertising and no analytics. Every calculation runs on your device.</string>
    <string name="about_storage">Your data stays here</string>
    <string name="about_storage_body">History, favorites and saved work live in a private database on this device. Android cloud backup is disabled. Uninstalling the app removes this data.</string>
    <string name="about_licenses">Open-source notices</string>
    <string name="about_licenses_body">Kotlin (Apache 2.0), AndroidX and Jetpack Compose (Apache 2.0), Room (Apache 2.0), DataStore (Apache 2.0), WorkManager (Apache 2.0), kotlinx.serialization (Apache 2.0) and the Material Symbols icon set (Apache 2.0). No third-party formula datasets, proprietary calculator code or paid SDKs are used.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">No network requests. No telemetry. Calculations are never uploaded. Export is an explicit action you take with the system file picker.</string>
    <string name="about_legal">Legal</string>
    <string name="about_legal_body">NEXCALC is an independent application owned by Shohan Khan. Formulas are provided for educational and professional estimation; verify critical results independently.</string>
    <string name="about_developer">Built with Jetpack Compose, Kotlin and the NEXCALC mathematical engine.</string>

